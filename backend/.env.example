# Application
APP_ENV=development

DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single-owner access protection
# Required in production. Use a random value at least 32 characters long.
VIZORA_ACCESS_TOKEN=

# Leave blank to automatically enable in production
# and disable in development.
VIZORA_RATE_LIMITING_ENABLED=

VIZORA_AI_RATE_LIMIT_PER_MINUTE=12
VIZORA_SEARCH_RATE_LIMIT_PER_MINUTE=10
VIZORA_EMBEDDING_RATE_LIMIT_PER_MINUTE=240
VIZORA_UPLOAD_RATE_LIMIT_PER_MINUTE=6

# Optional persistent storage directory.
# Example:
# VIZORA_STORAGE_DIR=/var/data/vizora
VIZORA_STORAGE_DIR=

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_IMAGE_EMBEDDING_MODEL=gemini-embedding-2

# Search
SEMANTIC_SEARCH_MIN_SCORE=0.42
SEMANTIC_SEARCH_SCORE_WINDOW=0.18